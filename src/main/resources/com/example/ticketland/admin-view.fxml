<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox spacing="10" xmlns="http://javafx.gluonhq.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ticketland.AdminController"
      style="-fx-padding: 20; -fx-background-color: #f9f9f9;">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Panel Administrador" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <Button text="Cerrar sesión" onAction="#cerrarSesion"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
    </HBox>

    <TabPane>
        <Tab text="Eventos" closable="false">
            <VBox spacing="10" style="-fx-padding: 10;">
                <TableView fx:id="tablaEventos" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                        <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="100"/>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="Activar" onAction="#activarEvento"
                            style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
                    <Button text="Pausar" onAction="#pausarEvento"
                            style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
                    <Button text="Cancelar" onAction="#cancelarEvento"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                </HBox>
                <Label fx:id="lblMensajeEvento" style="-fx-text-fill: green;"/>
            </VBox>
        </Tab>

        <Tab text="Usuarios" closable="false">
            <VBox spacing="10" style="-fx-padding: 10;">
                <TableView fx:id="tablaUsuarios" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colUsuarioNombre" text="Nombre" prefWidth="150"/>
                        <TableColumn fx:id="colUsuarioCorreo" text="Correo" prefWidth="200"/>
                        <TableColumn fx:id="colUsuarioTelefono" text="Teléfono" prefWidth="120"/>
                    </columns>
                </TableView>
                <Button text="Eliminar usuario" onAction="#eliminarUsuario"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                <Label fx:id="lblMensajeUsuario" style="-fx-text-fill: green;"/>
            </VBox>
        </Tab>

        <Tab text="Compras" closable="false">
            <VBox spacing="10" style="-fx-padding: 10;">
                <TableView fx:id="tablaCompras" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colCompraUsuario" text="Usuario" prefWidth="150"/>
                        <TableColumn fx:id="colCompraEvento" text="Evento" prefWidth="150"/>
                        <TableColumn fx:id="colCompraTotal" text="Total" prefWidth="100"/>
                        <TableColumn fx:id="colCompraEstado" text="Estado" prefWidth="100"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="Cancelar compra" onAction="#cancelarCompra"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                    <Button text="Confirmar compra" onAction="#confirmarCompra"
                            style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
                    <Button text="Exportar CSV" onAction="#exportarCSV"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
                    <Button text="Exportar PDF" onAction="#exportarPDF"
                            style="-fx-background-color: #8e44ad; -fx-text-fill: white;"/>
                </HBox>
                <Label fx:id="lblMensajeCompra" style="-fx-text-fill: green;"/>
            </VBox>
        </Tab>

        <Tab text="Métricas" closable="false">
            <VBox spacing="15" style="-fx-padding: 10;">
                <Button text="Actualizar métricas" onAction="#actualizarMetricas"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                <HBox spacing="20">
                    <VBox>
                        <Label text="Ventas por evento" style="-fx-font-weight: bold;"/>
                        <BarChart fx:id="chartVentas" prefWidth="350" prefHeight="250">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis/></yAxis>
                        </BarChart>
                    </VBox>
                    <VBox>
                        <Label text="Estado de compras" style="-fx-font-weight: bold;"/>
                        <PieChart fx:id="chartEstados" prefWidth="300" prefHeight="250"/>
                    </VBox>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>