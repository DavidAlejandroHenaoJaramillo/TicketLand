<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ticketland.LoginController"
      style="-fx-background-color: #1a1a2e;">

    <!-- HEADER -->
    <VBox alignment="CENTER" spacing="6" style="-fx-padding: 40 0 30 0;">
        <Label text="🎫 TicketLand"
               style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #e94560;"/>
        <Label text="Plataforma de gestión de eventos y venta de entradas"
               style="-fx-font-size: 13; -fx-text-fill: #a0a0b0;"/>
    </VBox>

    <!-- CARD LOGIN -->
    <VBox alignment="CENTER" spacing="14"
          style="-fx-background-color: #16213e; -fx-padding: 35; -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0, 0, 4);
                 -fx-max-width: 380;">
        <Label text="Iniciar sesión"
               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <TextField fx:id="txtCorreo" promptText="Correo electrónico"
                   prefWidth="310"
                   style="-fx-background-color: #0f3460; -fx-text-fill: white;
                          -fx-prompt-text-fill: #6c7a89; -fx-background-radius: 6;
                          -fx-padding: 10; -fx-border-color: #e94560; -fx-border-radius: 6;"/>

        <PasswordField fx:id="txtPassword" promptText="Contraseña"
                       prefWidth="310"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white;
                              -fx-prompt-text-fill: #6c7a89; -fx-background-radius: 6;
                              -fx-padding: 10; -fx-border-color: #e94560; -fx-border-radius: 6;"/>

        <Button text="Ingresar como Usuario" onAction="#loginUsuario"
                prefWidth="310"
                style="-fx-background-color: #e94560; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 6;
                       -fx-padding: 10; -fx-cursor: hand;"/>

        <Button text="Ingresar como Administrador" onAction="#loginAdmin"
                prefWidth="310"
                style="-fx-background-color: #0f3460; -fx-text-fill: #e94560;
                       -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 6;
                       -fx-padding: 10; -fx-cursor: hand;
                       -fx-border-color: #e94560; -fx-border-radius: 6;"/>

        <Button text="¿No tienes cuenta? Regístrate" onAction="#irARegistro"
                prefWidth="310"
                style="-fx-background-color: transparent; -fx-text-fill: #a0a0b0;
               -fx-font-size: 12; -fx-cursor: hand; -fx-underline: true;"/>

        <Label fx:id="lblMensaje"
               style="-fx-text-fill: #e94560; -fx-font-size: 12;"/>

        <Label text="Prueba: luna@gmail.com | carlos@gmail.com | maria@gmail.com"
               style="-fx-text-fill: #5a5a7a; -fx-font-size: 11;"/>
    </VBox>

    <VBox style="-fx-padding: 20 0 0 0;">
        <Label text="© 2026 TicketLand - Todos los derechos reservados"
               style="-fx-text-fill: #3a3a5a; -fx-font-size: 11;"/>
    </VBox>
</VBox>