<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="10" xmlns="http://javafx.gluonhq.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ticketland.UsuarioController"
      style="-fx-padding: 20; -fx-background-color: #f9f9f9;">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="lblBienvenida" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <Button text="Cerrar sesión" onAction="#cerrarSesion"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
    </HBox>

    <TabPane>
        <!-- TAB EVENTOS -->
        <Tab text="Eventos disponibles" closable="false">
            <VBox spacing="10" style="-fx-padding: 10;">
                <HBox spacing="10">
                    <TextField fx:id="txtFiltroCiudad" promptText="Filtrar por ciudad"/>
                    <TextField fx:id="txtFiltroCategoria" promptText="Filtrar por categoría"/>
                    <Button text="Buscar" onAction="#buscarEventos"
                            style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                </HBox>
                <TableView fx:id="tablaEventos" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colNombre" text="Evento" prefWidth="150"/>
                        <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="100"/>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                        <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="100"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                    </columns>
                </TableView>
                <Button text="Comprar entrada" onAction="#comprarEntrada"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Servicios adicionales:"/>
                    <CheckBox fx:id="chkVIP" text="Acceso VIP (+$100.000)"/>
                    <CheckBox fx:id="chkSeguro" text="Seguro (+$20.000)"/>
                    <CheckBox fx:id="chkMerchandising" text="Merchandising (+$50.000)"/>
                    <CheckBox fx:id="chkParqueadero" text="Parqueadero (+$30.000)"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- TAB HISTORIAL -->
        <Tab text="Mis compras" closable="false">
            <VBox spacing="10" style="-fx-padding: 10;">
                <TableView fx:id="tablaCompras" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colCompraFecha" text="Fecha" prefWidth="100"/>
                        <TableColumn fx:id="colCompraEvento" text="Evento" prefWidth="150"/>
                        <TableColumn fx:id="colCompraTotal" text="Total" prefWidth="100"/>
                        <TableColumn fx:id="colCompraEstado" text="Estado" prefWidth="100"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="Cancelar compra" onAction="#cancelarCompra"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                    <Button text="Exportar CSV" onAction="#exportarCSV"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
                </HBox>
                <Label fx:id="lblMensajeCompra" style="-fx-text-fill: green;"/>
            </VBox>
        </Tab>
        <!-- TAB PERFIL -->
        <Tab text="Mi perfil" closable="false">
            <VBox spacing="12" style="-fx-padding: 15;">
                <Label text="Editar perfil" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Nombre:" minWidth="80"/>
                    <TextField fx:id="txtNombre" prefWidth="250"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Correo:" minWidth="80"/>
                    <TextField fx:id="txtCorreo" prefWidth="250"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Teléfono:" minWidth="80"/>
                    <TextField fx:id="txtTelefono" prefWidth="250"/>
                </HBox>
                <Button text="Guardar cambios" onAction="#guardarPerfil"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
                <Label fx:id="lblMensajePerfil" style="-fx-text-fill: green;"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>