<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="viewController.UsuarioViewController"
      style="-fx-background-color: #f0f4ff;"
      stylesheets="@style.css">

    <HBox spacing="16" alignment="CENTER_LEFT"
          style="-fx-padding: 14 24; -fx-background-color: #003bbf;
                 -fx-border-color: #0057ff; -fx-border-width: 0 0 2 0;">
        <Label text="🎫 TicketLand"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label fx:id="lblBienvenida"
               style="-fx-font-size: 13; -fx-text-fill: #a0c0ff;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblNotificacion"
               style="-fx-background-color: #e94560; -fx-text-fill: white;
                      -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11;"/>
        <Button text="⏏ Cerrar sesión" onAction="#cerrarSesion"
                style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-border-color: white; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-padding: 6 14; -fx-cursor: hand;"/>
    </HBox>

    <TabPane VBox.vgrow="ALWAYS"
             style="-fx-background-color: #f0f4ff; -fx-tab-min-width: 130;">

        <Tab text="🎭 Explorar" closable="false">
            <SplitPane dividerPositions="0.42"
                       style="-fx-background-color: #f0f4ff; -fx-padding: 0;">

                <VBox spacing="10" style="-fx-padding: 16; -fx-background-color: #f0f4ff;">
                    <Label text="Eventos disponibles"
                           style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #0a1628;"/>

                    <HBox spacing="8" alignment="CENTER_LEFT"
                          style="-fx-background-color: #ffffff; -fx-padding: 10 12;
                                 -fx-background-radius: 8;">
                        <TextField fx:id="txtFiltroCiudad" promptText="🏙 Ciudad" prefWidth="110"
                                   style="-fx-background-color: #e8eeff; -fx-text-fill: #0a1628;
                                          -fx-prompt-text-fill: #8090b0; -fx-background-radius: 6;
                                          -fx-padding: 8; -fx-border-color: #b0c8ff; -fx-border-radius: 6;"/>
                        <TextField fx:id="txtFiltroCategoria" promptText="🎵 Categoría" prefWidth="110"
                                   style="-fx-background-color: #e8eeff; -fx-text-fill: #0a1628;
                                          -fx-prompt-text-fill: #8090b0; -fx-background-radius: 6;
                                          -fx-padding: 8; -fx-border-color: #b0c8ff; -fx-border-radius: 6;"/>
                        <TextField fx:id="txtFiltroPrecio" promptText="💰 Precio máx" prefWidth="110"
                                   style="-fx-background-color: #e8eeff; -fx-text-fill: #0a1628;
                                          -fx-prompt-text-fill: #8090b0; -fx-background-radius: 6;
                                          -fx-padding: 8; -fx-border-color: #b0c8ff; -fx-border-radius: 6;"/>
                        <Button text="Buscar" onAction="#buscarEventos"
                                style="-fx-background-color: #0057ff; -fx-text-fill: white;
                                       -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;
                                       -fx-font-weight: bold;"/>
                    </HBox>

                    <TableView fx:id="tablaEventos" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: #e8eeff; -fx-border-color: #b0c8ff;
                                      -fx-background-radius: 8;">
                        <columns>
                            <TableColumn fx:id="colNombre"    text="Evento"     prefWidth="170"/>
                            <TableColumn fx:id="colCiudad"    text="Ciudad"     prefWidth="90"/>
                            <TableColumn fx:id="colFecha"     text="Fecha"      prefWidth="95"/>
                            <TableColumn fx:id="colCategoria" text="Tipo"       prefWidth="85"/>
                            <TableColumn fx:id="colEstado"    text="Estado"     prefWidth="90"/>
                        </columns>
                        <placeholder>
                            <Label text="No hay eventos disponibles con esos filtros."
                                   style="-fx-text-fill: #8090b0;"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <ScrollPane fitToWidth="true"
                            style="-fx-background: #ffffff; -fx-background-color: #ffffff;">
                    <VBox spacing="14" style="-fx-padding: 18; -fx-background-color: #ffffff;">

                        <VBox fx:id="panelDetalleEvento" spacing="10"
                              style="-fx-background-color: #e8eeff; -fx-padding: 16;
                                     -fx-background-radius: 10;">
                            <Label text="← Selecciona un evento"
                                   style="-fx-font-size: 14; -fx-text-fill: #8090b0; -fx-font-style: italic;"/>
                            <Label fx:id="lblDetalleNombre"
                                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0057ff;
                                          -fx-wrap-text: true;"/>
                            <HBox spacing="20">
                                <VBox spacing="4">
                                    <Label text="📍 Lugar" style="-fx-text-fill: #5570a0; -fx-font-size: 11;"/>
                                    <Label fx:id="lblDetalleLugar"
                                           style="-fx-text-fill: #0a1628; -fx-font-size: 13;"/>
                                </VBox>
                                <VBox spacing="4">
                                    <Label text="📅 Fecha" style="-fx-text-fill: #5570a0; -fx-font-size: 11;"/>
                                    <Label fx:id="lblDetalleFecha"
                                           style="-fx-text-fill: #0a1628; -fx-font-size: 13;"/>
                                </VBox>
                                <VBox spacing="4">
                                    <Label text="🎭 Tipo" style="-fx-text-fill: #5570a0; -fx-font-size: 11;"/>
                                    <Label fx:id="lblDetalleCategoria"
                                           style="-fx-text-fill: #0a1628; -fx-font-size: 13;"/>
                                </VBox>
                            </HBox>
                            <VBox spacing="4">
                                <Label text="📝 Descripción" style="-fx-text-fill: #5570a0; -fx-font-size: 11;"/>
                                <Label fx:id="lblDetalleDescripcion"
                                       style="-fx-text-fill: #2a3a5a; -fx-font-size: 12; -fx-wrap-text: true;"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="📋 Políticas" style="-fx-text-fill: #5570a0; -fx-font-size: 11;"/>
                                <Label fx:id="lblDetallePoliticas"
                                       style="-fx-text-fill: #2a3a5a; -fx-font-size: 12; -fx-wrap-text: true;"/>
                            </VBox>
                        </VBox>

                        <VBox spacing="8"
                              style="-fx-background-color: #e8eeff; -fx-padding: 14;
                                     -fx-background-radius: 10;">
                            <Label text="🗺 Disponibilidad por zona"
                                   style="-fx-font-weight: bold; -fx-text-fill: #0a1628; -fx-font-size: 13;"/>
                            <TableView fx:id="tablaZonas" prefHeight="130"
                                       style="-fx-background-color: #e8eeff; -fx-border-color: #b0c8ff;
                                              -fx-background-radius: 8;">
                                <columns>
                                    <TableColumn fx:id="colZonaNombre"      text="Zona"        prefWidth="130"/>
                                    <TableColumn fx:id="colZonaTipo"        text="Tipo"        prefWidth="80"/>
                                    <TableColumn fx:id="colZonaPrecio"      text="Precio"      prefWidth="90"/>
                                    <TableColumn fx:id="colZonaDisponibles" text="Disponibles" prefWidth="90"/>
                                    <TableColumn fx:id="colZonaCapacidad"   text="Capacidad"   prefWidth="80"/>
                                </columns>
                            </TableView>
                        </VBox>

                        <VBox spacing="10"
                              style="-fx-background-color: #ffffff; -fx-padding: 16;
                                     -fx-background-radius: 10; -fx-border-color: #0057ff;
                                     -fx-border-width: 1; -fx-border-radius: 10;">
                            <Label text="🛒 Comprar entrada"
                                   style="-fx-font-weight: bold; -fx-text-fill: #0057ff; -fx-font-size: 14;"/>

                            <GridPane hgap="12" vgap="8">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90" prefWidth="90"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="Zona:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                       style="-fx-text-fill: #5570a0;"/>
                                <ComboBox fx:id="cmbZona" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                          maxWidth="Infinity"
                                          style="-fx-background-color: #e8eeff; -fx-text-fill: #0a1628;"/>
                                <Label text="Asiento:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                       style="-fx-text-fill: #5570a0;"/>
                                <ComboBox fx:id="cmbAsiento" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                          maxWidth="Infinity"
                                          style="-fx-background-color: #e8eeff; -fx-text-fill: #0a1628;"/>
                                <Label text="Método de pago:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                       style="-fx-text-fill: #5570a0;"/>
                                <ComboBox fx:id="cmbMetodoPago" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                          maxWidth="Infinity"
                                          style="-fx-background-color: #e8eeff; -fx-text-fill: #0a1628;"/>
                            </GridPane>

                            <Label fx:id="lblInfoZona"
                                   style="-fx-text-fill: #2ecc71; -fx-font-size: 11; -fx-font-style: italic;"/>

                            <Label text="Servicios adicionales:"
                                   style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                            <HBox spacing="12">
                                <VBox spacing="4" style="-fx-background-color: #e8eeff; -fx-padding: 8;
                                                          -fx-background-radius: 6;" prefWidth="100">
                                    <CheckBox fx:id="chkVIP" text="VIP"
                                              style="-fx-text-fill: #f39c12; -fx-font-weight: bold;"/>
                                    <Label text="+$100.000"
                                           style="-fx-text-fill: #8090b0; -fx-font-size: 10;"/>
                                </VBox>
                                <VBox spacing="4" style="-fx-background-color: #e8eeff; -fx-padding: 8;
                                                          -fx-background-radius: 6;" prefWidth="100">
                                    <CheckBox fx:id="chkSeguro" text="Seguro"
                                              style="-fx-text-fill: #0057ff;"/>
                                    <Label text="+$20.000"
                                           style="-fx-text-fill: #8090b0; -fx-font-size: 10;"/>
                                </VBox>
                                <VBox spacing="4" style="-fx-background-color: #e8eeff; -fx-padding: 8;
                                                          -fx-background-radius: 6;" prefWidth="115">
                                    <CheckBox fx:id="chkMerchandising" text="Merchandise"
                                              style="-fx-text-fill: #9b59b6;"/>
                                    <Label text="+$50.000"
                                           style="-fx-text-fill: #8090b0; -fx-font-size: 10;"/>
                                </VBox>
                                <VBox spacing="4" style="-fx-background-color: #e8eeff; -fx-padding: 8;
                                                          -fx-background-radius: 6;" prefWidth="115">
                                    <CheckBox fx:id="chkParqueadero" text="Parqueadero"
                                              style="-fx-text-fill: #2ecc71;"/>
                                    <Label text="+$30.000"
                                           style="-fx-text-fill: #8090b0; -fx-font-size: 10;"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="10" alignment="CENTER_LEFT"
                                  style="-fx-background-color: #e8eeff; -fx-padding: 10;
                                         -fx-background-radius: 8;">
                                <Label text="Total estimado:"
                                       style="-fx-text-fill: #5570a0;"/>
                                <Label fx:id="lblTotalEstimado"
                                       style="-fx-text-fill: #0057ff; -fx-font-size: 18;
                                              -fx-font-weight: bold;"/>
                            </HBox>

                            <Button text="🎟 Confirmar compra" onAction="#comprarEntrada"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #e94560; -fx-text-fill: white;
                                           -fx-font-size: 14; -fx-font-weight: bold;
                                           -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>
                            <Label fx:id="lblMensajeCompra"
                                   style="-fx-font-size: 12;" wrapText="true"/>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </SplitPane>
        </Tab>

        <Tab text="🗺 Mapa Asientos" closable="false">
            <VBox spacing="12" style="-fx-padding: 18; -fx-background-color: #f0f4ff;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Mapa visual de asientos"
                           style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #0a1628;"/>
                    <Label fx:id="lblInfoMapa"
                           style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                </HBox>

                <HBox spacing="20" style="-fx-background-color: #ffffff; -fx-padding: 10 14;
                                          -fx-background-radius: 8;">
                    <Label text="Leyenda:" style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                    <HBox spacing="6" alignment="CENTER">
                        <Label text="●" style="-fx-text-fill: #2ecc71; -fx-font-size: 16;"/>
                        <Label text="Disponible" style="-fx-text-fill: #0a1628; -fx-font-size: 12;"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER">
                        <Label text="●" style="-fx-text-fill: #f39c12; -fx-font-size: 16;"/>
                        <Label text="Reservado" style="-fx-text-fill: #0a1628; -fx-font-size: 12;"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER">
                        <Label text="●" style="-fx-text-fill: #e74c3c; -fx-font-size: 16;"/>
                        <Label text="Vendido" style="-fx-text-fill: #0a1628; -fx-font-size: 12;"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER">
                        <Label text="●" style="-fx-text-fill: #b0c0d0; -fx-font-size: 16;"/>
                        <Label text="Bloqueado" style="-fx-text-fill: #0a1628; -fx-font-size: 12;"/>
                    </HBox>
                </HBox>

                <TableView fx:id="tablaMapaAsientos" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #ffffff; -fx-border-color: #b0c8ff;
                                  -fx-background-radius: 8;">
                    <columns>
                        <TableColumn fx:id="colMapaAsientoId" text="#"       prefWidth="50"/>
                        <TableColumn fx:id="colMapaFila"      text="Fila"    prefWidth="70"/>
                        <TableColumn fx:id="colMapaNumero"    text="Número"  prefWidth="80"/>
                        <TableColumn fx:id="colMapaZona"      text="Zona"    prefWidth="180"/>
                        <TableColumn fx:id="colMapaTipo"      text="Tipo"    prefWidth="100"/>
                        <TableColumn fx:id="colMapaPrecio"    text="Precio"  prefWidth="100"/>
                        <TableColumn fx:id="colMapaEstado"    text="Estado"  prefWidth="120"/>
                    </columns>
                    <placeholder>
                        <Label text="Selecciona un evento en 'Explorar' para ver el mapa de asientos."
                               style="-fx-text-fill: #8090b0;"/>
                    </placeholder>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="📋 Mis Compras" closable="false">
            <SplitPane dividerPositions="0.55"
                       style="-fx-background-color: #f0f4ff;">

                <VBox spacing="12" style="-fx-padding: 18; -fx-background-color: #f0f4ff;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Historial de compras"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #0a1628;"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 Actualizar" onAction="#refrescarHistorial"
                                style="-fx-background-color: #e8eeff; -fx-text-fill: #0057ff;
                                       -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>
                    </HBox>

                    <HBox spacing="8" alignment="CENTER_LEFT"
                          style="-fx-background-color: #ffffff; -fx-padding: 10 12;
                                 -fx-background-radius: 8;">
                        <Label text="Estado:" style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                        <ComboBox fx:id="cmbFiltroEstado" prefWidth="140"
                                  style="-fx-background-color: #e8eeff; -fx-text-fill: #0a1628;"/>
                        <Button text="Filtrar" onAction="#filtrarHistorial"
                                style="-fx-background-color: #ffffff; -fx-text-fill: #0057ff;
                                       -fx-border-color: #0057ff; -fx-border-radius: 6;
                                       -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>
                        <Button text="Ver todas" onAction="#mostrarTodasCompras"
                                style="-fx-background-color: transparent; -fx-text-fill: #8090b0;
                                       -fx-padding: 6 12; -fx-cursor: hand;"/>
                    </HBox>

                    <TableView fx:id="tablaCompras" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: #ffffff; -fx-border-color: #b0c8ff;
                                      -fx-background-radius: 8;">
                        <columns>
                            <TableColumn fx:id="colCompraFecha"  text="Fecha"   prefWidth="95"/>
                            <TableColumn fx:id="colCompraEvento" text="Evento"  prefWidth="160"/>
                            <TableColumn fx:id="colCompraTotal"  text="Total"   prefWidth="90"/>
                            <TableColumn fx:id="colCompraEstado" text="Estado"  prefWidth="110"/>
                        </columns>
                        <placeholder>
                            <Label text="No tienes compras registradas."
                                   style="-fx-text-fill: #8090b0;"/>
                        </placeholder>
                    </TableView>

                    <HBox spacing="10">
                        <Button text="❌ Cancelar compra" onAction="#cancelarCompra"
                                style="-fx-background-color: #e94560; -fx-text-fill: white;
                                       -fx-background-radius: 6; -fx-padding: 8 14; -fx-cursor: hand;"/>
                        <Button text="📄 Exportar CSV" onAction="#exportarCSV"
                                style="-fx-background-color: #e8eeff; -fx-text-fill: #0057ff;
                                       -fx-border-color: #b0c8ff; -fx-border-radius: 6;
                                       -fx-background-radius: 6; -fx-padding: 8 14; -fx-cursor: hand;"/>
                        <Button text="📑 Exportar PDF" onAction="#exportarPDF"
                                style="-fx-background-color: #8e44ad; -fx-text-fill: white;
                                       -fx-background-radius: 6; -fx-padding: 8 14; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <ScrollPane fitToWidth="true"
                            style="-fx-background: #ffffff; -fx-background-color: #ffffff;">
                    <VBox spacing="14" style="-fx-padding: 18; -fx-background-color: #ffffff;">
                        <Label text="Detalle de compra"
                               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0a1628;"/>

                        <VBox fx:id="panelComprobante" spacing="10"
                              style="-fx-background-color: #e8eeff; -fx-padding: 16;
                                     -fx-background-radius: 10;">
                            <Label text="Selecciona una compra para ver el detalle."
                                   style="-fx-text-fill: #8090b0; -fx-font-style: italic;"/>
                            <Label fx:id="lblComprobanteEvento"
                                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #0057ff;
                                          -fx-wrap-text: true;"/>
                            <GridPane hgap="16" vgap="6">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="110" prefWidth="110"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="ID Compra:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                       style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                                <Label fx:id="lblComprobanteId" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                       style="-fx-text-fill: #0a1628;"/>
                                <Label text="Fecha:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                       style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                                <Label fx:id="lblComprobanteFecha" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                       style="-fx-text-fill: #0a1628;"/>
                                <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                       style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                                <Label fx:id="lblComprobanteEstado" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                       style="-fx-text-fill: #2ecc71; -fx-font-weight: bold;"/>
                                <Label text="Método de pago:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                       style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                                <Label fx:id="lblComprobantePago" GridPane.columnIndex="1" GridPane.rowIndex="3"
                                       style="-fx-text-fill: #0a1628;"/>
                                <Label text="Recinto:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                       style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                                <Label fx:id="lblComprobanteRecinto" GridPane.columnIndex="1" GridPane.rowIndex="4"
                                       style="-fx-text-fill: #0a1628;"/>
                            </GridPane>

                            <Label text="Entradas:" style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                            <TableView fx:id="tablaEntradasCompra" prefHeight="140"
                                       style="-fx-background-color: #ffffff; -fx-border-color: #b0c8ff;">
                                <columns>
                                    <TableColumn fx:id="colEntradaId"      text="#"       prefWidth="40"/>
                                    <TableColumn fx:id="colEntradaZona"    text="Zona"    prefWidth="120"/>
                                    <TableColumn fx:id="colEntradaAsiento" text="Asiento" prefWidth="80"/>
                                    <TableColumn fx:id="colEntradaCosto"   text="Precio"  prefWidth="90"/>
                                    <TableColumn fx:id="colEntradaEstado"  text="Estado"  prefWidth="90"/>
                                </columns>
                            </TableView>

                            <HBox spacing="10" alignment="CENTER_RIGHT"
                                  style="-fx-background-color: #ffffff; -fx-padding: 10;
                                         -fx-background-radius: 8;">
                                <Label text="TOTAL:"
                                       style="-fx-text-fill: #5570a0; -fx-font-size: 14;"/>
                                <Label fx:id="lblComprobanteTotal"
                                       style="-fx-text-fill: #0057ff; -fx-font-size: 20;
                                              -fx-font-weight: bold;"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </SplitPane>
        </Tab>

        <Tab text="👤 Mi Perfil" closable="false">
            <ScrollPane fitToWidth="true"
                        style="-fx-background: #f0f4ff; -fx-background-color: #f0f4ff;">
                <HBox spacing="20" style="-fx-padding: 24; -fx-background-color: #f0f4ff;">

                    <VBox spacing="16" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #ffffff; -fx-padding: 22;
                                 -fx-background-radius: 12; -fx-max-width: 420;">
                        <Label text="📝 Datos personales"
                               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0a1628;"/>
                        <VBox spacing="6">
                            <Label text="Nombre completo" style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                            <TextField fx:id="txtNombre" prefWidth="340"
                                       style="-fx-background-color: #e8eeff; -fx-text-fill: #0a1628;
                                              -fx-background-radius: 8; -fx-padding: 10;
                                              -fx-border-color: #b0c8ff; -fx-border-radius: 8;"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Correo electrónico" style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                            <TextField fx:id="txtCorreo" prefWidth="340"
                                       style="-fx-background-color: #e8eeff; -fx-text-fill: #0a1628;
                                              -fx-background-radius: 8; -fx-padding: 10;
                                              -fx-border-color: #b0c8ff; -fx-border-radius: 8;"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Teléfono" style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                            <TextField fx:id="txtTelefono" prefWidth="340"
                                       style="-fx-background-color: #e8eeff; -fx-text-fill: #0a1628;
                                              -fx-background-radius: 8; -fx-padding: 10;
                                              -fx-border-color: #b0c8ff; -fx-border-radius: 8;"/>
                        </VBox>
                        <Button text="💾 Guardar cambios" onAction="#guardarPerfil"
                                prefWidth="340"
                                style="-fx-background-color: #0057ff; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-padding: 11; -fx-cursor: hand;"/>
                        <Label fx:id="lblMensajePerfil" wrapText="true" style="-fx-font-size: 12;"/>
                    </VBox>

                    <VBox spacing="16" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #ffffff; -fx-padding: 22;
                                 -fx-background-radius: 12; -fx-max-width: 420;">
                        <Label text="💳 Métodos de pago"
                               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0a1628;"/>
                        <TableView fx:id="tablaMetodosPago" prefHeight="160"
                                   style="-fx-background-color: #e8eeff; -fx-border-color: #b0c8ff;
                                          -fx-background-radius: 8;">
                            <columns>
                                <TableColumn fx:id="colPagoTipo"    text="Tipo"    prefWidth="150"/>
                                <TableColumn fx:id="colPagoDetalle" text="Detalle" prefWidth="190"/>
                            </columns>
                            <placeholder>
                                <Label text="Sin métodos de pago registrados."
                                       style="-fx-text-fill: #8090b0;"/>
                            </placeholder>
                        </TableView>
                        <Label text="Agregar método de pago:"
                               style="-fx-text-fill: #5570a0; -fx-font-size: 12;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <ComboBox fx:id="cmbTipoPago" prefWidth="140"
                                      style="-fx-background-color: #e8eeff; -fx-text-fill: #0a1628;"/>
                            <TextField fx:id="txtDatoPago" promptText="Número/Banco/—" prefWidth="170"
                                       style="-fx-background-color: #e8eeff; -fx-text-fill: #0a1628;
                                              -fx-prompt-text-fill: #8090b0; -fx-background-radius: 6;
                                              -fx-padding: 9; -fx-border-color: #b0c8ff; -fx-border-radius: 6;"/>
                            <Button text="➕" onAction="#agregarMetodoPago"
                                    style="-fx-background-color: #2ecc71; -fx-text-fill: white;
                                           -fx-background-radius: 6; -fx-padding: 9 14; -fx-cursor: hand;
                                           -fx-font-weight: bold;"/>
                        </HBox>
                        <Label fx:id="lblMensajePago" style="-fx-font-size: 12;"/>

                        <Separator style="-fx-background-color: #b0c8ff;"/>
                        <Label text="📊 Mis estadísticas"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #5570a0;"/>
                        <HBox spacing="14">
                            <VBox spacing="4" alignment="CENTER"
                                  style="-fx-background-color: #e8eeff; -fx-padding: 12;
                                         -fx-background-radius: 8;" prefWidth="90">
                                <Label fx:id="lblStatCompras"
                                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #e94560;"/>
                                <Label text="Compras" style="-fx-text-fill: #5570a0; -fx-font-size: 11;"/>
                            </VBox>
                            <VBox spacing="4" alignment="CENTER"
                                  style="-fx-background-color: #e8eeff; -fx-padding: 12;
                                         -fx-background-radius: 8;" prefWidth="110">
                                <Label fx:id="lblStatGastado"
                                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0057ff;"/>
                                <Label text="Total gastado" style="-fx-text-fill: #5570a0; -fx-font-size: 11;"/>
                            </VBox>
                            <VBox spacing="4" alignment="CENTER"
                                  style="-fx-background-color: #e8eeff; -fx-padding: 12;
                                         -fx-background-radius: 8;" prefWidth="100">
                                <Label fx:id="lblStatEventos"
                                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                                <Label text="Eventos" style="-fx-text-fill: #5570a0; -fx-font-size: 11;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                </HBox>
            </ScrollPane>
        </Tab>

    </TabPane>
</VBox>